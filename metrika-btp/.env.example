# ╔══════════════════════════════════════════════════════════════╗
# ║  Variables d'environnement — Metrika BTP                       ║
# ║  Copiez ce fichier en .env (local) ou renseignez-les sur Vercel║
# ╚══════════════════════════════════════════════════════════════╝

# ── Base de données PostgreSQL ───────────────────────────────────
# DATABASE_URL : connexion utilisée par l'application (poolée en prod).
# DIRECT_URL   : connexion directe (non poolée) utilisée pour `prisma db push`.
# En local, mettez la même valeur pour les deux.
# Sur Neon/Vercel Postgres, copiez les deux chaînes depuis le dashboard
# (l'URL poolée contient souvent "-pooler" / "?pgbouncer=true").
DATABASE_URL="postgresql://metrika:metrika@localhost:5432/metrika?schema=public"
DIRECT_URL="postgresql://metrika:metrika@localhost:5432/metrika?schema=public"

# ── Auth.js (NextAuth) ───────────────────────────────────────────
# Générez un secret : openssl rand -base64 32
AUTH_SECRET="changez-moi-en-production"
AUTH_TRUST_HOST=true
# URL publique de l'app. En local : http://localhost:3000
# Sur Vercel : https://votre-projet.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Utilisateur unique autorisé (créé via le seed) ───────────────
ADMIN_EMAIL="admin@metrika.ma"
ADMIN_PASSWORD="MetrikaMaroc2026!"

# ── API Claude (Anthropic) ───────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Stockage des fichiers ────────────────────────────────────────
# STORAGE_DRIVER : "local" (disque, dev) ou "vercel-blob" (prod Vercel).
# ⚠️ Sur Vercel le système de fichiers est en lecture seule : utilisez
#    "vercel-blob" en production, sinon les uploads échoueront.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# Requis uniquement si STORAGE_DRIVER="vercel-blob".
# Ajouté automatiquement par Vercel quand vous créez un store Blob
# (onglet Storage → Create → Blob). À ne renseigner à la main qu'en local.
BLOB_READ_WRITE_TOKEN=""
