// ╔══════════════════════════════════════════════════════════════╗
// ║  Metrika Métrage BTP Maroc — Schéma PRODUCTION (PostgreSQL)     ║
// ║  Utilisé par Vercel via le script "build" (--schema).          ║
// ║  Le dev local utilise prisma/schema.prisma (SQLite).           ║
// ║  Les deux fichiers ont des MODÈLES IDENTIQUES : seule la        ║
// ║  datasource change. Le client Prisma généré est donc le même.  ║
// ╚══════════════════════════════════════════════════════════════╝

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion runtime (poolée — Neon/Vercel)
  directUrl = env("DIRECT_URL")   // connexion directe pour `prisma db push`
}

// ── Authentification (utilisateur unique) ────────────────────────
// Valeurs role : "ADMIN"
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("ADMIN")
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  treatments    Treatment[]
  documents     Document[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Paramètres entreprise (en-tête de tous les documents) ────────
model Company {
  id            String   @id @default(cuid())
  name          String
  legalForm     String?
  logoUrl       String?
  stampUrl      String?
  ice           String?
  rc            String?
  ifNumber      String?
  cnss          String?
  patente       String?
  capital       String?
  country       String   @default("Maroc")
  currency      String   @default("MAD")
  siret         String?
  vatNumber     String?
  ape           String?
  address       String?
  city          String?
  phone         String?
  email         String?
  website       String?
  bankName      String?
  rib           String?
  iban          String?
  swift         String?
  vatRate       Float    @default(20)
  quotePrefix   String   @default("DEV")
  quoteCounter  Int      @default(1)
  paymentTerms  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Clients & projets ────────────────────────────────────────────
model Client {
  id        String   @id @default(cuid())
  name      String
  ice       String?
  contact   String?
  address   String?
  city      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  projects  Project[]
  quotes    Quote[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  reference   String?
  type        String?
  location    String?
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   Document[]
  cctps       Cctp[]
  dpgfs       Dpgf[]
  quotes      Quote[]
}

// ── Documents & historique des traitements ───────────────────────
// kind   : "UPLOAD" | "PDF_MERGED" | "IMAGE_PDF" | "CCTP" | "DPGF" | "SOUS_DETAIL" | "DEVIS" | "OTHER"
// status : "DRAFT" | "PENDING_REVIEW" | "VALIDATED" | "GENERATED" | "ARCHIVED"
model Document {
  id          String        @id @default(cuid())
  name        String
  kind        String
  mimeType    String?
  size        Int?
  storageKey  String
  status      String        @default("DRAFT")
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  treatmentId String?
  treatment   Treatment?    @relation(fields: [treatmentId], references: [id])
  createdAt   DateTime      @default(now())
}

// agent  : "PDF" | "CCTP" | "DPGF" | "SOUS_DETAIL" | "PRICING" | "DEVIS"
// status : "QUEUED" | "RUNNING" | "AWAITING_VALIDATION" | "DONE" | "FAILED"
model Treatment {
  id          String        @id @default(cuid())
  agent       String
  action      String
  status      String          @default("QUEUED")
  inputMeta   String?
  outputMeta  String?
  error       String?
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  documents   Document[]
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?
}

// ── Agent CCTP ────────────────────────────────────────────────────
model Cctp {
  id          String     @id @default(cuid())
  title       String
  projectType String?
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  status      String     @default("DRAFT")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sections    CctpSection[]
  dpgfs       Dpgf[]
}

model CctpSection {
  id       String @id @default(cuid())
  cctpId   String
  cctp     Cctp   @relation(fields: [cctpId], references: [id], onDelete: Cascade)
  lot      String
  order    Int    @default(0)
  content  String
}

// ── Agent DPGF ────────────────────────────────────────────────────
model Dpgf {
  id        String     @id @default(cuid())
  title     String
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id])
  cctpId    String?
  cctp      Cctp?      @relation(fields: [cctpId], references: [id])
  status    String     @default("PENDING_REVIEW")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lines     DpgfLine[]
}

model DpgfLine {
  id           String   @id @default(cuid())
  dpgfId       String
  dpgf         Dpgf     @relation(fields: [dpgfId], references: [id], onDelete: Cascade)
  lot          String
  code         String?
  designation  String
  description  String?
  unit         String
  quantity     Float    @default(0)
  unitPrice    Float    @default(0)
  quantitySource String?
  validated    Boolean  @default(false)
  order        Int      @default(0)
  sousDetail   SousDetail?
}

// ── Agent Sous-détail de prix ─────────────────────────────────────
model SousDetail {
  id          String   @id @default(cuid())
  dpgfLineId  String?  @unique
  dpgfLine    DpgfLine? @relation(fields: [dpgfLineId], references: [id])
  designation String
  unit        String
  yield       Float    @default(1)
  debourseSec     Float @default(0)
  generalFeesRate Float @default(0.10)
  profitRate      Float @default(0.10)
  sellingPrice    Float @default(0)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  components  SousDetailComponent[]
}

// type : "MAIN_OEUVRE" | "MATERIAUX" | "MATERIEL"
model SousDetailComponent {
  id           String      @id @default(cuid())
  sousDetailId String
  sousDetail   SousDetail  @relation(fields: [sousDetailId], references: [id], onDelete: Cascade)
  type         String
  designation  String
  unit         String
  quantity     Float       @default(0)
  unitCost     Float       @default(0)
}

// ── Bibliothèque de prix ──────────────────────────────────────────
model PriceItem {
  id            String   @id @default(cuid())
  designation   String
  unit          String
  unitPrice     Float
  category      String?
  lot           String?
  supplier      String?
  source        String?
  marginRate    Float    @default(0.10)
  generalFeesRate Float  @default(0.10)
  sellingPrice  Float    @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  history       PriceHistory[]

  @@index([designation])
  @@index([lot, category])
}

model PriceHistory {
  id          String   @id @default(cuid())
  priceItemId String
  priceItem   PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  unitPrice   Float
  sellingPrice Float
  recordedAt  DateTime @default(now())
}

// ── Générateur de devis ───────────────────────────────────────────
model Quote {
  id          String      @id @default(cuid())
  number      String      @unique
  title       String?
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  issueDate   DateTime    @default(now())
  validityDays Int        @default(30)
  vatRate     Float       @default(20)
  totalHT     Float       @default(0)
  totalVAT    Float       @default(0)
  totalTTC    Float       @default(0)
  notes       String?
  status      String      @default("DRAFT")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       QuoteLine[]
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  designation String
  description String?
  unit        String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  order       Int    @default(0)
}
